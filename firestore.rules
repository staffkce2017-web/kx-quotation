rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write for quotations so real-time onSnapshot syncs across all devices
    match /quotations/{quotationId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
